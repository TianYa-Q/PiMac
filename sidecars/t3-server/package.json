    "undici": "8.11.2",
    "unified": "11.0.5",
    "yaml": "2.9.0",
    "yauzl": "3.4.0"
  },
  "overrides": {
    "@opencode/client": { "effect": "$effect" },
    "@opencode/protocol": { "effect": "$effect" },
    "@opencode/schema": { "effect": "$effect" }
