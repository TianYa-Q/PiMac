{
  "name": "pimac-goal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PiMac presentation adapter for the unmodified @schovest/pi-goal extension",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "@schovest/pi-goal": "0.2.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "24.12.4",
    "typebox": "1.3.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
