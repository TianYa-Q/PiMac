{
  "name": "account-usage",
  "version": "1.1.0",
  "description": "OpenAI ChatGPT and Codex multi-account management for Pi Coding Agent",
  "license": "MIT",
  "author": "TianYa-Q",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TianYa-Q/PiMac.git",
    "directory": "extensions/account-usage"
  },
  "homepage": "https://github.com/TianYa-Q/PiMac/tree/main/extensions/account-usage#readme",
  "bugs": {
    "url": "https://github.com/TianYa-Q/PiMac/issues"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "codex",
    "account-usage"
  ],
  "files": [
    "*.ts",
    "LICENSE",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "format": "prettier --write '*.ts' 'tests/*.mjs' package.json tsconfig.json",
    "format:check": "prettier --check '*.ts' 'tests/*.mjs' package.json tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "lint": "oxlint . --ignore-pattern node_modules",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run format:check"
  },
  "dependencies": {
    "proper-lockfile": "4.1.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.99.1",
    "@earendil-works/pi-coding-agent": ">=0.99.1",
    "@earendil-works/pi-tui": ">=0.99.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/proper-lockfile": "4.1.4",
    "jiti": "^2.7.0",
    "oxlint": "^1.14.0",
    "prettier": "3.6.2",
    "typescript": "7.0.2"
  }
}
